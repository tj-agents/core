{
  "schema_version": 1,
  "plugin": "tj-agents/base",
  "source_roots": [
    ".agents/base",
    ".agents/hooks/hook_dispatch.py",
    ".agents/hooks/hook_runtime.py"
  ],
  "requires": {
    "marketplaces": [
      {
        "id": "tj-agents",
        "repository": "tj-agents/marketplace"
      }
    ],
    "plugins": [
      "tj-agents/base"
    ],
    "hooks": [
      {
        "path": ".agents/base/policy/agent-files/scripts/session-context.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": ".agents/base/policy/idea-initialization/scripts/session-context.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": ".agents/base/policy/task-routing/scripts/session-context.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/hook_dispatch.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/pre_tool_use_adapter.py",
        "hosts": [
          "codex"
        ]
      },
      {
        "path": "hooks/skill_router.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/tier_gate.py",
        "hosts": [
          "claude",
          "codex"
        ]
      }
    ],
    "permissions": {
      "claude_allow": [],
      "codex_prefix_rules": []
    }
  }
}
