{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "tj_hook",
            "args": [
              "--",
              "python",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/tier_gate.py",
              "--session-context"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "tj_hook",
            "args": [
              "--",
              "python",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/tier_gate.py",
              "--write-gate"
            ]
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "if": "Read(//**/SKILL.md)",
            "timeout": 30,
            "command": "tj_hook",
            "args": [
              "--",
              "python",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/tier_gate.py",
              "--record-read"
            ]
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "tj_hook",
            "args": [
              "--",
              "python",
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/tier_gate.py",
              "--compacted"
            ]
          }
        ]
      }
    ]
  }
}
