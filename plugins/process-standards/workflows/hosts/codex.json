{
  "contract_version": "v2",
  "host": "codex",
  "status": "available-with-parent-fallback",
  "delivery": {
    "project_directory": ".codex/agents",
    "plugin_directory": "codex-agents",
    "extension": ".toml",
    "project_installer": ".codex/install-workflow-agents.ps1",
    "plugin_installer": "scripts/install-codex-agents.ps1",
    "plugin_loading": "unsupported-use-project-installer"
  },
  "probe": {
    "command": "codex",
    "version_arguments": ["--version"]
  },
  "concurrency": {
    "readers": "parallel",
    "writers": "serialized",
    "nested_dispatch": false
  },
  "fallback_reasons": [
    "host-unavailable",
    "role-unavailable",
    "model-unavailable",
    "unsupported-capability",
    "invalid-result",
    "cancelled"
  ],
  "semantic_stages": {
    "strategic": {
      "route": {"tags": ["architecture"]},
      "unavailable": "decision"
    },
    "implementation": {
      "route": {},
      "unavailable": "typed-parent-fallback"
    },
    "mechanical": {
      "route": {
        "reversibility": "reversible",
        "blast": "file",
        "ambiguity": "specified",
        "verifiability": "compiler"
      },
      "unavailable": "typed-parent-fallback"
    },
    "review": {
      "route": {"tags": ["review"]},
      "unavailable": "decision"
    },
    "critical": {
      "route": {"tags": ["security"]},
      "unavailable": "decision"
    }
  },
  "continuation": {
    "wake": "in-chat-scheduled-task",
    "scope": "same-chat-local-project-worktree",
    "unsupported_gate": "product-capability-unavailable"
  },
  "roles": {
    "evidence-explorer": {
      "agent_name": "workflow_evidence_explorer",
      "filename": "workflow-evidence-explorer.toml",
      "description": "Read-only repository evidence explorer for one bounded workflow question.",
      "body": "../roles/evidence-explorer.md",
      "default_stage": "mechanical",
      "allowed_stages": ["strategic", "implementation", "mechanical", "critical"],
      "sandbox_mode": "read-only"
    },
    "log-analyst": {
      "agent_name": "workflow_log_analyst",
      "filename": "workflow-log-analyst.toml",
      "description": "Read-only analyst for reducing supplied logs into evidence without diagnosing the fix.",
      "body": "../roles/log-analyst.md",
      "default_stage": "mechanical",
      "allowed_stages": ["implementation", "mechanical", "critical"],
      "sandbox_mode": "read-only"
    },
    "test-impact-analyst": {
      "agent_name": "workflow_test_impact_analyst",
      "filename": "workflow-test-impact-analyst.toml",
      "description": "Read-only analyst for affected tests, gaps, and repository-supported validation commands.",
      "body": "../roles/test-impact-analyst.md",
      "default_stage": "implementation",
      "allowed_stages": ["implementation", "review"],
      "sandbox_mode": "read-only"
    },
    "review-lens": {
      "agent_name": "workflow_review_lens",
      "filename": "workflow-review-lens.toml",
      "description": "Read-only independent review lens over one immutable diff and bounded concern.",
      "body": "../roles/review-lens.md",
      "default_stage": "review",
      "allowed_stages": ["review"],
      "sandbox_mode": "read-only"
    },
    "mechanical-worker": {
      "agent_name": "workflow_mechanical_worker",
      "filename": "workflow-mechanical-worker.toml",
      "description": "Serialized mechanical writer restricted to one parent-approved writer lease.",
      "body": "../roles/mechanical-worker.md",
      "default_stage": "mechanical",
      "allowed_stages": ["mechanical"],
      "sandbox_mode": "workspace-write"
    }
  }
}
