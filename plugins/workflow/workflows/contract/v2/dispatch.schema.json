{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concertable.dev/agent-workflows/v2/dispatch.schema.json",
  "title": "Agent workflow dispatch envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "workflow_id",
    "workflow_run_id",
    "stage_id",
    "dispatch_id",
    "capability",
    "objective",
    "context",
    "permissions",
    "result_schema",
    "decision_boundary",
    "acceptance_conditions",
    "deadline",
    "failure_behavior"
  ],
  "properties": {
    "contract_version": {"const": "v2"},
    "workflow_id": {"$ref": "#/$defs/identifier"},
    "workflow_run_id": {"$ref": "#/$defs/identifier"},
    "stage_id": {"$ref": "#/$defs/identifier"},
    "semantic_stage": {
      "enum": ["strategic", "implementation", "mechanical", "review", "critical"]
    },
    "dispatch_id": {"$ref": "#/$defs/identifier"},
    "capability": {
      "enum": [
        "evidence-explorer",
        "log-analyst",
        "test-impact-analyst",
        "review-lens",
        "mechanical-worker"
      ]
    },
    "objective": {"$ref": "#/$defs/non_empty_string"},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_paths",
        "immutable_artifacts",
        "supplied_logs",
        "prior_decisions",
        "assumptions"
      ],
      "properties": {
        "repository_paths": {"$ref": "#/$defs/string_array"},
        "immutable_artifacts": {"$ref": "#/$defs/string_array"},
        "supplied_logs": {"$ref": "#/$defs/string_array"},
        "prior_decisions": {"$ref": "#/$defs/string_array"},
        "assumptions": {"$ref": "#/$defs/string_array"}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "files", "tools", "allow_subdispatch"],
      "properties": {
        "mode": {"enum": ["read", "write"]},
        "files": {"$ref": "#/$defs/string_array"},
        "tools": {"$ref": "#/$defs/string_array"},
        "allow_subdispatch": {"const": false},
        "writer_lease": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lease_id", "paths"],
          "properties": {
            "lease_id": {"$ref": "#/$defs/identifier"},
            "paths": {"$ref": "#/$defs/non_empty_string_array"}
          }
        }
      }
    },
    "result_schema": {"const": "result.schema.json"},
    "decision_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_decide", "must_not_decide"],
      "properties": {
        "may_decide": {"$ref": "#/$defs/non_empty_string_array"},
        "must_not_decide": {"$ref": "#/$defs/non_empty_string_array"}
      }
    },
    "acceptance_conditions": {"$ref": "#/$defs/non_empty_string_array"},
    "deadline": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["deadline_utc"],
          "properties": {"deadline_utc": {"$ref": "#/$defs/non_empty_string"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cancellation_condition"],
          "properties": {"cancellation_condition": {"$ref": "#/$defs/non_empty_string"}}
        }
      ]
    },
    "failure_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertainty", "missing_context", "conflicting_evidence", "incomplete_result"],
      "properties": {
        "uncertainty": {"$ref": "#/$defs/non_empty_string"},
        "missing_context": {"$ref": "#/$defs/non_empty_string"},
        "conflicting_evidence": {"$ref": "#/$defs/non_empty_string"},
        "incomplete_result": {"$ref": "#/$defs/non_empty_string"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"capability": {"const": "mechanical-worker"}},
        "required": ["capability"]
      },
      "then": {
        "properties": {
          "permissions": {
            "required": ["writer_lease"],
            "properties": {"mode": {"const": "write"}}
          }
        }
      },
      "else": {
        "properties": {
          "permissions": {
            "properties": {"mode": {"const": "read"}},
            "not": {"required": ["writer_lease"]}
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "non_empty_string": {"type": "string", "minLength": 1},
    "string_array": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/non_empty_string"},
      "uniqueItems": true
    }
  }
}
