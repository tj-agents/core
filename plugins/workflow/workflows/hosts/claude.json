{
  "host": "claude",
  "delivery": {
    "project_directory": ".claude/agents",
    "plugin_directory": "agents",
    "extension": ".md",
    "plugin_loading": "supported"
  },
  "roles": {
    "evidence-explorer": {
      "agent_name": "evidence-explorer",
      "filename": "evidence-explorer.md",
      "description": "Read-only repository evidence explorer for one bounded workflow question.",
      "body": "../roles/evidence-explorer.md",
      "model": "claude-sonnet-5",
      "effort": "medium",
      "tools": [
        "Read",
        "Glob",
        "Grep"
      ],
      "disallowed_tools": [
        "Agent"
      ],
      "kind": "review"
    },
    "log-analyst": {
      "agent_name": "log-analyst",
      "filename": "log-analyst.md",
      "description": "Read-only analyst for reducing supplied logs into evidence without diagnosing the fix.",
      "body": "../roles/log-analyst.md",
      "model": "claude-sonnet-5",
      "effort": "medium",
      "tools": [
        "Read",
        "Glob",
        "Grep"
      ],
      "disallowed_tools": [
        "Agent"
      ],
      "kind": "review"
    },
    "test-impact-analyst": {
      "agent_name": "test-impact-analyst",
      "filename": "test-impact-analyst.md",
      "description": "Read-only analyst for affected tests, gaps, and repository-supported validation commands.",
      "body": "../roles/test-impact-analyst.md",
      "model": "claude-sonnet-5",
      "effort": "high",
      "tools": [
        "Read",
        "Glob",
        "Grep"
      ],
      "disallowed_tools": [
        "Agent"
      ],
      "kind": "review"
    },
    "review-lens": {
      "agent_name": "review-lens",
      "filename": "review-lens.md",
      "description": "Read-only independent review lens over one immutable diff and bounded concern.",
      "body": "../roles/review-lens.md",
      "model": "claude-sonnet-5",
      "effort": "high",
      "tools": [
        "Read",
        "Glob",
        "Grep"
      ],
      "disallowed_tools": [
        "Agent"
      ],
      "kind": "review"
    },
    "mechanical-worker": {
      "agent_name": "mechanical-worker",
      "filename": "mechanical-worker.md",
      "description": "Serialized mechanical writer restricted to one parent-approved writer lease.",
      "body": "../roles/mechanical-worker.md",
      "model": "claude-sonnet-5",
      "effort": "medium",
      "tools": [
        "Read",
        "Glob",
        "Grep",
        "Write",
        "Edit",
        "Bash"
      ],
      "disallowed_tools": [
        "Agent"
      ],
      "kind": "worker"
    }
  }
}
