{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tj-agents/core/catalog/plugins.lock.schema.json",
  "title": "Repository plugin lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "marketplaces",
    "plugins"
  ],
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^(tj-agents|Concertable)/[A-Za-z0-9_][A-Za-z0-9_.-]*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)|[0-9a-f]{40})$"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 3
    },
    "marketplaces": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "properties": {
        "tj-agents": {
          "allOf": [
            {
              "$ref": "#/$defs/pin"
            },
            {
              "properties": {
                "repository": {
                  "const": "tj-agents/marketplace"
                }
              }
            }
          ]
        },
        "base-agents": {
          "allOf": [
            {
              "$ref": "#/$defs/pin"
            },
            {
              "properties": {
                "repository": {
                  "const": "tj-agents/core"
                }
              }
            }
          ]
        }
      },
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "#/$defs/pin"
          },
          {
            "not": {
              "properties": {
                "repository": {
                  "enum": [
                    "tj-agents/marketplace",
                    "tj-agents/core"
                  ]
                }
              },
              "required": [
                "repository"
              ]
            }
          }
        ]
      },
      "anyOf": [
        {
          "required": [
            "tj-agents"
          ]
        },
        {
          "required": [
            "base-agents"
          ]
        }
      ]
    },
    "plugins": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*@[a-z][a-z0-9-]*$"
      },
      "oneOf": [
        {
          "allOf": [
            {
              "contains": {
                "const": "base@tj-agents"
              }
            },
            {
              "contains": {
                "const": "engineering@tj-agents"
              }
            },
            {
              "contains": {
                "const": "machine@tj-agents"
              }
            },
            {
              "not": {
                "contains": {
                  "enum": [
                    "base@base-agents",
                    "engineering@base-agents",
                    "machine@base-agents"
                  ]
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "contains": {
                "const": "base@base-agents"
              }
            },
            {
              "contains": {
                "const": "engineering@base-agents"
              }
            },
            {
              "contains": {
                "const": "machine@base-agents"
              }
            },
            {
              "not": {
                "contains": {
                  "enum": [
                    "base@tj-agents",
                    "engineering@tj-agents",
                    "machine@tj-agents"
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  }
}
