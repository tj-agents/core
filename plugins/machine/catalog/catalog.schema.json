{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tj-agents/core/catalog/catalog.schema.json",
  "title": "Agent capability catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "digest_format",
    "releases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "digest_format": {
      "const": "sha256-tree-v1"
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/release"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)?$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner_repository",
        "source",
        "marketplace",
        "revision",
        "version",
        "plugins"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "owner_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "marketplace": {
          "$ref": "#/$defs/identifier"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "plugins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/plugin"
          }
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "package_path",
        "version",
        "description",
        "status",
        "platforms",
        "skills",
        "dependencies",
        "external_prerequisites",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "package_path": {
          "type": "string",
          "pattern": "^plugins/[a-z0-9][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "current",
            "deprecated"
          ]
        },
        "replacement": {
          "$ref": "#/$defs/stringList"
        },
        "remove_after": {
          "type": "string",
          "format": "date"
        },
        "platforms": {
          "$ref": "#/$defs/stringList"
        },
        "skills": {
          "$ref": "#/$defs/stringList"
        },
        "dependencies": {
          "$ref": "#/$defs/dependencies"
        },
        "external_prerequisites": {
          "$ref": "#/$defs/dependencies"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "digest_excludes": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "$ref": "#/$defs/stringList"
        },
        "optional": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  }
}
