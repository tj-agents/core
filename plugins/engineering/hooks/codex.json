{
  "description": "Selected engineering mechanisms. Repository policy gates require their existing opt-in files. Codex result-event hooks remain unwired until the host publishes a supported result payload.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/.agents/engineering/contract/session-guidance/scripts/session-context.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/.agents/engineering/contract/session-guidance/scripts/session-context.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/worktree_cleanup_gate.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/worktree_cleanup_gate.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/skill_router.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/skill_router.py\""
          }
        ],
        "matcher": "apply_patch|edit_file|write_file|multi_edit|exec_command|unified_exec|local_shell|shell"
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/git_auth_scope_gate.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/git_auth_scope_gate.py\""
          }
        ],
        "matcher": "exec_command|unified_exec|local_shell|shell"
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/forge_poll_gate.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/forge_poll_gate.py\""
          }
        ],
        "matcher": "exec_command|unified_exec|local_shell|shell"
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/compact_output_gate.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/compact_output_gate.py\""
          }
        ],
        "matcher": "exec_command|unified_exec|local_shell|shell"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/workflow_route.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/workflow_route.py\""
          }
        ]
      }
    ]
  }
}
