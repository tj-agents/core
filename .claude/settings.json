{
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-4-6"
  },
  "permissions": {
    "allow": [
      "PowerShell(Set-Location *)",
      "Bash(git fetch *)",
      "PowerShell(Get-ChildItem *)",
      "Bash(az account show)",
      "PowerShell(Get-Content *)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git mv *)",
      "Bash(git branch *)",
      "Bash(git stash *)"
    ]
  }
}
