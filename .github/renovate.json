{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.agents/plugins/runtime-sources\\.json$/"
      ],
      "matchStrings": [
        "\"repository\": \"tj-agents/(?<depName>[a-z0-9-]+)\",\\s*\"revision\": \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/tj-agents/{{{depName}}}",
      "currentValueTemplate": "main"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "groupName": "runtime sources",
      "labels": ["ci:full"]
    }
  ]
}
