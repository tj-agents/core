{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tj-agents/core/catalog/plugins.lock.schema.json",
  "title": "Repository plugin lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "marketplaces", "plugins"],
  "properties": {
    "schema_version": {"const": 2},
    "marketplaces": {
      "type": "object",
      "required": ["tj-agents"],
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "revision"],
        "properties": {
          "repository": {"type": "string", "pattern": "^(tj-agents|Concertable)/[A-Za-z0-9_.-]+$"},
          "revision": {"type": "string", "pattern": "^(v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)|[0-9a-f]{40})$"}
        }
      },
      "properties": {
        "tj-agents": {"properties": {"repository": {"const": "tj-agents/marketplace"}}}
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[a-z][a-z0-9-]*$"},
      "allOf": [
        {"contains": {"const": "base@tj-agents"}},
        {"contains": {"const": "engineering@tj-agents"}},
        {"contains": {"const": "machine@tj-agents"}}
      ]
    }
  }
}
