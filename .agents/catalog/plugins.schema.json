{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tj-agents/core/catalog/plugins.schema.json",
  "title": "Repository plugin selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "marketplace", "plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"const": "tj-agents/marketplace"}
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    }
  }
}
