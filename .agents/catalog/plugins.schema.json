{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tj-agents/core/catalog/plugins.schema.json",
  "title": "Repository plugin selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "marketplaces",
    "plugins"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^(tj-agents|Concertable)/[A-Za-z0-9_][A-Za-z0-9_.-]*$"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "marketplaces": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "properties": {
        "tj-agents": {
          "allOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "properties": {
                "repository": {
                  "const": "tj-agents/marketplace"
                }
              }
            }
          ]
        }
      },
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "#/$defs/source"
          },
          {
            "not": {
              "properties": {
                "repository": {
                  "enum": [
                    "tj-agents/marketplace",
                    "tj-agents/core"
                  ]
                }
              },
              "required": [
                "repository"
              ]
            }
          }
        ]
      },
      "minProperties": 1
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*@[a-z][a-z0-9-]*$"
      }
    }
  }
}
