{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/hook_dispatch.py\" --deadline 7 --hook \"${PLUGIN_ROOT}/.agents/machine/utility/peer-cli/scripts/register_session.py\" --hook \"${PLUGIN_ROOT}/resources/machine/scripts/reap_orphans.py\" --notice --hook \"${PLUGIN_ROOT}/resources/machine/scripts/codex_terminal_profile.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/hook_dispatch.py\" --deadline 7 --hook \"${PLUGIN_ROOT}/.agents/machine/utility/peer-cli/scripts/register_session.py\" --hook \"${PLUGIN_ROOT}/resources/machine/scripts/reap_orphans.py\" --notice --hook \"${PLUGIN_ROOT}/resources/machine/scripts/codex_terminal_profile.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/hook_dispatch.py\" --deadline 12 --hook \"${PLUGIN_ROOT}/.agents/machine/utility/close/scripts/close_session.py\" hook --hook \"${PLUGIN_ROOT}/resources/machine/scripts/session_store.py\" hook prompt --host codex",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/hook_dispatch.py\" --deadline 12 --hook \"${PLUGIN_ROOT}/.agents/machine/utility/close/scripts/close_session.py\" hook --hook \"${PLUGIN_ROOT}/resources/machine/scripts/session_store.py\" hook prompt --host codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/hook_dispatch.py\" --deadline 55 --hook \"${PLUGIN_ROOT}/resources/machine/scripts/session_store.py\" hook stop --host codex --hook \"${PLUGIN_ROOT}/.agents/machine/utility/close/scripts/close_session.py\" hook",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/hook_dispatch.py\" --deadline 55 --hook \"${PLUGIN_ROOT}/resources/machine/scripts/session_store.py\" hook stop --host codex --hook \"${PLUGIN_ROOT}/.agents/machine/utility/close/scripts/close_session.py\" hook"
          }
        ]
      }
    ]
  }
}
