{
  "description": "Workflow session lifecycle: close the session when owned work is finished.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/hook_dispatch.py\" --deadline 7 --hook \"${PLUGIN_ROOT}/.agents/workflow/policy/session-lifecycle/scripts/session-context.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/hook_dispatch.py\" --deadline 7 --hook \"${PLUGIN_ROOT}/.agents/workflow/policy/session-lifecycle/scripts/session-context.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/hook_dispatch.py\" --deadline 10 --hook \"${PLUGIN_ROOT}/.agents/workflow/policy/session-lifecycle/scripts/session-context.py\" --prompt",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/hook_dispatch.py\" --deadline 10 --hook \"${PLUGIN_ROOT}/.agents/workflow/policy/session-lifecycle/scripts/session-context.py\" --prompt"
          }
        ]
      }
    ]
  }
}
