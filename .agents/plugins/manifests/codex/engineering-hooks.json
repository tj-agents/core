{
  "description": "Selected engineering mechanisms: an agent never widens the account's GitHub credential.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/git_auth_scope_gate.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/pre_tool_use_adapter.py\" --timeout 12 \"${PLUGIN_ROOT}/hooks/git_auth_scope_gate.py\""
          }
        ],
        "matcher": "exec_command|unified_exec|local_shell|shell"
      }
    ]
  }
}
