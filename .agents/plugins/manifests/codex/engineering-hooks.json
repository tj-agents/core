{
  "description": "Selected engineering mechanisms. Repository policy gates require their existing opt-in files. Codex result-event hooks remain unwired until the host publishes a supported result payload.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/hook_dispatch.py\" --deadline 12 --hook \"${PLUGIN_ROOT}/.agents/engineering/policy/session-guidance/scripts/session-context.py\" --hook \"${PLUGIN_ROOT}/hooks/worktree_cleanup_gate.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/hook_dispatch.py\" --deadline 12 --hook \"${PLUGIN_ROOT}/.agents/engineering/policy/session-guidance/scripts/session-context.py\" --hook \"${PLUGIN_ROOT}/hooks/worktree_cleanup_gate.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/git_auth_scope_gate.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/pre_tool_use_adapter.py\" --timeout 12 \"${PLUGIN_ROOT}/hooks/git_auth_scope_gate.py\""
          }
        ],
        "matcher": "exec_command|unified_exec|local_shell|shell"
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/forge_poll_gate.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/pre_tool_use_adapter.py\" --timeout 12 \"${PLUGIN_ROOT}/hooks/forge_poll_gate.py\""
          }
        ],
        "matcher": "exec_command|unified_exec|local_shell|shell"
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/compact_output_gate.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/pre_tool_use_adapter.py\" --timeout 12 \"${PLUGIN_ROOT}/hooks/compact_output_gate.py\""
          }
        ],
        "matcher": "exec_command|unified_exec|local_shell|shell"
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/delivery_binding_gate.py\" --validate-body",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/pre_tool_use_adapter.py\" --timeout 57 \"${PLUGIN_ROOT}/hooks/delivery_binding_gate.py\" --validate-body"
          }
        ],
        "matcher": "exec_command|unified_exec|local_shell|shell"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/workflow_route.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/workflow_route.py\""
          }
        ]
      }
    ]
  }
}
