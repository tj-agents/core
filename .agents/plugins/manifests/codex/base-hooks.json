{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/tier_gate.py\" --session-context",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/tier_gate.py\" --session-context",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|shell|shell_command|exec_command|mcp__.*|.*create_worktree",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/worktree_tool_gate.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/worktree_tool_gate.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/tier_gate.py\" --tool-gate",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/tier_gate.py\" --tool-gate",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
