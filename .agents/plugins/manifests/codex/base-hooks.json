{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/tier_gate.py\" --session-context",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/tier_gate.py\" --session-context",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|shell|shell_command|exec_command|.*create_worktree",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/worktrees/worktree_gate.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/worktrees/worktree_gate.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/tier_gate.py\" --tool-context",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/tier_gate.py\" --tool-context",
            "timeout": 30,
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/tier_gate.py\" --compacted",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/tier_gate.py\" --compacted",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
