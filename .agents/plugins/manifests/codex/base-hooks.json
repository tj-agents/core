{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/dependencies/agent/.agents/agent/runtime/managed_admission.py\" hook --host codex",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/dependencies/agent/.agents/agent/runtime/managed_admission.py\" hook --host codex"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/tier_gate.py\" --session-context",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/tier_gate.py\" --session-context",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/dependencies/agent/.agents/agent/runtime/managed_admission.py\" hook --host codex",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/dependencies/agent/.agents/agent/runtime/managed_admission.py\" hook --host codex"
          }
        ],
        "matcher": "*"
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/tier_gate.py\" --tool-context",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/tier_gate.py\" --tool-context",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -B \"${PLUGIN_ROOT}/dependencies/agent/.agents/agent/runtime/managed_admission.py\" hook --host codex",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/dependencies/agent/.agents/agent/runtime/managed_admission.py\" hook --host codex"
          }
        ]
      }
    ]
  }
}
