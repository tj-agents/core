{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_dispatch.py",
              "--deadline",
              "25",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/hooks/tier_gate.py",
              "--session-context",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/.agents/base/policy/agent-files/scripts/session-context.py",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/.agents/base/policy/idea-initialization/scripts/session-context.py"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "onFailure": "block",
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_dispatch.py",
              "--deadline",
              "25",
              "--deny-on-timeout",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/hooks/skill_router.py",
              "--harness",
              "claude"
            ]
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell"
      }
    ]
  }
}
