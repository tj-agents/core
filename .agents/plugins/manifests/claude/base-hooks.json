{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_dispatch.py",
              "--deadline",
              "8",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/hooks/tier_gate.py",
              "--session-context",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/.agents/base/policy/agent-files/scripts/session-context.py",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/.agents/base/policy/idea-initialization/scripts/session-context.py",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/.agents/base/policy/task-routing/scripts/session-context.py"
            ]
          }
        ]
      }
    ]
  }
}
