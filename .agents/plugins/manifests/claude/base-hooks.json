{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/tier_gate.py",
              "--session-context"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|shell|shell_command|exec_command|mcp__.*|EnterWorktree|Agent|Task|.*create_worktree",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/worktree_tool_gate.py"
            ]
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/tier_gate.py",
              "--tool-gate"
            ]
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/worktrees/worktree_gate.py"
            ]
          }
        ]
      }
    ]
  }
}
