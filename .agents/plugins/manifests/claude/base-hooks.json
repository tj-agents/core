{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/.agents/base/policy/plan-artifacts/scripts/session-context.py"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/tier_gate.py",
              "--session-context"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/.agents/base/policy/agent-files/scripts/session-context.py"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/.agents/base/policy/goal-continuation/scripts/session-context.py"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 25,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_dispatch.py",
              "--deadline",
              "20",
              "${CLAUDE_PLUGIN_ROOT}/hooks/skill_router.py@Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
              "${CLAUDE_PLUGIN_ROOT}/hooks/tier_gate.py@Skill|Bash|PowerShell"
            ]
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|Skill"
      }
    ]
  }
}
