{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/tier_gate.py",
              "--session-context"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|shell|shell_command|exec_command|EnterWorktree|Agent|Task|.*create_worktree",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": ["-B", "${CLAUDE_PLUGIN_ROOT}/hooks/worktrees/worktree_gate.py"]
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/tier_gate.py",
              "--tool-context"
            ]
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": ["-B", "${CLAUDE_PLUGIN_ROOT}/hooks/worktrees/worktree_gate.py"]
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/tier_gate.py",
              "--compacted"
            ]
          }
        ]
      }
    ]
  }
}
