{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/.agents/machine/utility/peer-cli/scripts/register_session.py"
            ]
          },
          {
            "type": "command",
            "timeout": 15,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/resources/machine/scripts/prune_plugin_cache.py",
              "--pin",
              "--notice"
            ]
          },
          {
            "type": "command",
            "timeout": 10,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/resources/machine/scripts/reap_orphans.py",
              "--notice"
            ]
          },
          {
            "type": "command",
            "timeout": 10,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/resources/machine/scripts/claude_terminal_profile.py"
            ]
          },
          {
            "type": "command",
            "timeout": 10,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/.agents/machine/utility/bootstrap-capabilities/scripts/harness_permissions_sync.py",
              "--apply"
            ]
          }
        ]
      }
    ]
  }
}
