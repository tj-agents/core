{
  "description": "Selected engineering mechanisms: an agent never widens the account's GitHub credential.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_dispatch.py",
              "--deadline",
              "10",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/.agents/engineering/policy/session/scripts/session-context.py"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_dispatch.py",
              "--deadline",
              "25",
              "--deny-on-timeout",
              "--hook",
              "${CLAUDE_PLUGIN_ROOT}/hooks/git_auth_scope_gate.py"
            ]
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ]
  }
}
