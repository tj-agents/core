{
  "description": "Selected engineering mechanisms: an agent never widens the account's GitHub credential.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook_dispatch.py",
              "--deadline",
              "25",
              "--deny-on-timeout",
              "${CLAUDE_PLUGIN_ROOT}/hooks/git_auth_scope_gate.py@Bash|PowerShell"
            ]
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ]
  }
}
