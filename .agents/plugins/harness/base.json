{
  "schema_version": 1,
  "plugin": "tj-agents/base",
  "source_roots": [
    ".agents/base",
    ".agents/dependencies/cli/.agents/cli/runtime",
    ".agents/hooks/hook_runtime.py"
  ],
  "requires": {
    "marketplaces": [
      {
        "id": "tj-agents",
        "repository": "tj-agents/marketplace"
      }
    ],
    "plugins": [
      "tj-agents/base"
    ],
    "hooks": [
      {
        "path": "hooks/tier_gate.py",
        "hosts": [
          "claude",
          "codex"
        ]
      }
    ],
    "permissions": {
      "claude_allow": [],
      "codex_prefix_rules": []
    }
  }
}
