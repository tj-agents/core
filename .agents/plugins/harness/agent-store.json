{
  "schema_version": 1,
  "plugin": "base-agents/agent-store",
  "source_roots": [
    ".agents/agent-store"
  ],
  "requires": {
    "marketplaces": [
      {
        "id": "base-agents",
        "repository": "tj-agents/core"
      }
    ],
    "plugins": [
      "base-agents/agent-store"
    ],
    "hooks": [],
    "permissions": {
      "claude_allow": [
        "Bash(python -B ${PLUGIN_ROOT}/.agents/agent-store/utility/inspect/scripts/inspect.py:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/.agents/agent-store/utility/inspect/scripts/inspect.py:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/.agents/agent-store/utility/inspect/scripts/inspect.py:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/.agents/agent-store/utility/inspect/scripts/inspect.py:*)",
        "Bash(python -B ${PLUGIN_ROOT}/skills/inspect/scripts/inspect.py:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/skills/inspect/scripts/inspect.py:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/skills/inspect/scripts/inspect.py:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/skills/inspect/scripts/inspect.py:*)",
        "Bash(python -B ${PLUGIN_ROOT}/codex-skills/inspect/scripts/inspect.py:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/codex-skills/inspect/scripts/inspect.py:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/codex-skills/inspect/scripts/inspect.py:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/codex-skills/inspect/scripts/inspect.py:*)"
      ],
      "codex_prefix_rules": [
        {
          "pattern": [
            [
              "python",
              "python3"
            ],
            "-B",
            [
              "${PLUGIN_ROOT}/.agents/agent-store/utility/inspect/scripts/inspect.py",
              "${PLUGIN_ROOT}/skills/inspect/scripts/inspect.py",
              "${PLUGIN_ROOT}/codex-skills/inspect/scripts/inspect.py"
            ]
          ],
          "justification": "Read recorded agent execution and session metadata without creating or modifying its database or observing native processes.",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/codex-skills/inspect/scripts/inspect.py"
            ],
            [
              "python3",
              "-B",
              "${PLUGIN_ROOT}/.agents/agent-store/utility/inspect/scripts/inspect.py",
              "--repository",
              "github.com/owner/repo"
            ]
          ],
          "not_match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/writer.py"
            ]
          ]
        }
      ]
    }
  }
}
