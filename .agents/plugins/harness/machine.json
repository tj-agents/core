          "not_match": [
            [
              "python3",
              "-B",
              "${PLUGIN_ROOT}/.agents/machine/utility/plugin-selection/scripts/other.py",
              "--root",
              "/workspace/project"
            ]
          ]
        },
        {
          "pattern": [
            [
              "python",
              "python3"
            ],
            "-B",
            [
              "${PLUGIN_ROOT}/.agents/machine/utility/close/scripts/close_session.py",
              "${PLUGIN_ROOT}/skills/close/scripts/close_session.py",
              "${PLUGIN_ROOT}/codex-skills/close/scripts/close_session.py"
            ],
            "arm"
          ],
          "justification": "Arm a watcher that closes only this verified CLI after its final reply",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/.agents/machine/utility/close/scripts/close_session.py",
              "arm"
            ]
          ],
          "not_match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/.agents/machine/utility/close/scripts/close_session.py",
              "hook"
            ],
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/other.py",
              "arm"
            ]
          ]
        },
        {
          "pattern": [
            [
              "python",
              "python3"
            ],
            "-B",
            [
              "${PLUGIN_ROOT}/.agents/machine/scripts/reload_plugins.py",
              "${PLUGIN_ROOT}/resources/machine/scripts/reload_plugins.py",
              "${PLUGIN_ROOT}/skills/reload-plugins/scripts/reload_plugins.py",
              "${PLUGIN_ROOT}/codex-skills/reload-plugins/scripts/reload_plugins.py",
              "${PLUGIN_ROOT}/.agents/machine/utility/reload-plugins/scripts/reload_plugins.py"
            ]
          ],
          "justification": "Refresh selected tj-agents plugins through native host commands, with optional remote verification.",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/resources/machine/scripts/reload_plugins.py",
              "--project",
              "C:/repo"
            ],
            [
              "python3",
              "-B",
              "${PLUGIN_ROOT}/.agents/machine/scripts/reload_plugins.py",
              "--verify-only"
            ]
          ],
          "not_match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/resources/machine/scripts/other.py",
              "--project",
              "C:/repo"
            ]
          ]
        }
      ]
    }
  }
}
