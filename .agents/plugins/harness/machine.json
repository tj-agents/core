{
  "schema_version": 1,
  "plugin": "base-agents/machine",
  "source_roots": [
    ".agents/catalog/catalog.schema.json",
    ".agents/machine"
  ],
  "requires": {
    "marketplaces": [
      {
        "id": "base-agents",
        "repository": "tj-agents/core"
      }
    ],
    "plugins": [
      "base-agents/base",
      "base-agents/machine"
    ],
    "hooks": [
      {
        "path": ".agents/machine/utility/bootstrap-capabilities/scripts/harness_permissions_sync.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": ".agents/machine/utility/peer-cli/scripts/register_session.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/hook_dispatch.py",
        "hosts": [
          "codex"
        ]
      },
      {
        "path": "resources/machine/scripts/claude_terminal_profile.py",
        "hosts": [
          "claude"
        ]
      },
      {
        "path": "resources/machine/scripts/codex_terminal_profile.py",
        "hosts": [
          "codex"
        ]
      },
      {
        "path": "resources/machine/scripts/prune_plugin_cache.py",
        "hosts": [
          "claude"
        ]
      },
      {
        "path": "resources/machine/scripts/reap_orphans.py",
        "hosts": [
          "claude",
          "codex"
        ]
      }
    ],
    "permissions": {
      "claude_allow": [
        "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ${PLUGIN_ROOT}/.agents/machine/utility/peer-cli/scripts/finish.ps1)",
        "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ${PLUGIN_ROOT}/.agents/machine/utility/peer-cli/scripts/finish.ps1)",
        "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ${PLUGIN_ROOT}/skills/peer-cli/scripts/finish.ps1)",
        "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ${PLUGIN_ROOT}/skills/peer-cli/scripts/finish.ps1)",
        "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ${PLUGIN_ROOT}/.agents/machine/utility/peer-cli/scripts/close.ps1)",
        "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ${PLUGIN_ROOT}/.agents/machine/utility/peer-cli/scripts/close.ps1)",
        "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ${PLUGIN_ROOT}/skills/peer-cli/scripts/close.ps1)",
        "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ${PLUGIN_ROOT}/skills/peer-cli/scripts/close.ps1)",
        "Bash(python -B ${PLUGIN_ROOT}/skills/hook-control/scripts/hook_control.py *)",
        "Bash(python -B ${PLUGIN_ROOT}/.agents/machine/utility/hook-control/scripts/hook_control.py *)",
        "Bash(python3 -B ${PLUGIN_ROOT}/skills/hook-control/scripts/hook_control.py *)",
        "Bash(python3 -B ${PLUGIN_ROOT}/.agents/machine/utility/hook-control/scripts/hook_control.py *)"
      ],
      "codex_prefix_rules": [
        {
          "pattern": [
            [
              "powershell",
              "powershell.exe",
              "pwsh",
              "pwsh.exe"
            ],
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            [
              "${PLUGIN_ROOT}/.agents/machine/utility/peer-cli/scripts/finish.ps1",
              "${PLUGIN_ROOT}/skills/peer-cli/scripts/finish.ps1",
              "${PLUGIN_ROOT}/codex-skills/peer-cli/scripts/finish.ps1"
            ]
          ],
          "justification": "engineering:merge Step 5: finish closes this session's own CLI and removes its merged worktree after cleanup_proof.py approved it",
          "match": [
            [
              "powershell",
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${PLUGIN_ROOT}/.agents/machine/utility/peer-cli/scripts/finish.ps1"
            ],
            [
              "powershell.exe",
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${PLUGIN_ROOT}/codex-skills/peer-cli/scripts/finish.ps1"
            ]
          ],
          "not_match": [
            [
              "powershell",
              "-NoProfile",
              "-File",
              "${PLUGIN_ROOT}/.agents/machine/utility/peer-cli/scripts/finish.ps1"
            ]
          ]
        },
        {
          "pattern": [
            [
              "powershell",
              "powershell.exe",
              "pwsh",
              "pwsh.exe"
            ],
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            [
              "${PLUGIN_ROOT}/.agents/machine/utility/peer-cli/scripts/close.ps1",
              "${PLUGIN_ROOT}/skills/peer-cli/scripts/close.ps1",
              "${PLUGIN_ROOT}/codex-skills/peer-cli/scripts/close.ps1"
            ]
          ],
          "justification": "Close only this verified completed CLI session while retaining its checkout",
          "match": [
            [
              "powershell",
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${PLUGIN_ROOT}/.agents/machine/utility/peer-cli/scripts/close.ps1"
            ],
            [
              "powershell.exe",
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${PLUGIN_ROOT}/codex-skills/peer-cli/scripts/close.ps1"
            ]
          ],
          "not_match": [
            [
              "powershell",
              "-NoProfile",
              "-File",
              "${PLUGIN_ROOT}/.agents/machine/utility/peer-cli/scripts/close.ps1"
            ]
          ]
        },
        {
          "pattern": [
            [
              "python",
              "python3"
            ],
            "-B",
            [
              "${PLUGIN_ROOT}/.agents/machine/utility/hook-control/scripts/hook_control.py",
              "${PLUGIN_ROOT}/skills/hook-control/scripts/hook_control.py",
              "${PLUGIN_ROOT}/codex-skills/hook-control/scripts/hook_control.py"
            ],
            [
              "status",
              "off",
              "on"
            ]
          ],
          "justification": "machine:hook-control: inspect, suspend or restore the requested Codex configuration layer while preserving hook trust and plugin state",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/codex-skills/hook-control/scripts/hook_control.py",
              "off"
            ]
          ],
          "not_match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/codex-skills/hook-control/scripts/other.py",
              "off"
            ]
          ]
        }
      ]
    }
  }
}
