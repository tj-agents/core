{
  "schema_version": 1,
  "plugin": "tj-agents/engineering",
  "source_roots": [
    ".agents/agent-store/runtime",
    ".agents/engineering",
    ".agents/hooks/docs_reachability.py",
    ".agents/hooks/hook_dispatch.py",
    ".agents/hooks/problem_records.py",
    ".agents/workflow/resources/problem-records.md",
    ".agents/workflows",
    ".agents/workflows/repository_configuration.py",
    ".agents/workflows/review_evidence.py",
    ".agents/workflows/workflow_runtime.py"
  ],
  "requires": {
    "marketplaces": [
      {
        "id": "tj-agents",
        "repository": "tj-agents/marketplace"
      }
    ],
    "plugins": [
      "tj-agents/agent-store",
      "tj-agents/base",
      "tj-agents/cli",
      "tj-agents/engineering",
      "tj-agents/machine",
      "tj-agents/workflow"
    ],
    "hooks": [
      {
        "path": ".agents/engineering/policy/session/scripts/session-context.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/delivery_binding_gate.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/git_auth_scope_gate.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/hook_dispatch.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/pre_tool_use_adapter.py",
        "hosts": [
          "codex"
        ]
      }
    ],
    "permissions": {
      "claude_allow": [
        "Bash(python -B ${PLUGIN_ROOT}/workflows/completion.py)",
        "PowerShell(python -B ${PLUGIN_ROOT}/workflows/completion.py)",
        "Bash(python -B ${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/cleanup_proof.py)",
        "PowerShell(python -B ${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/cleanup_proof.py)",
        "Bash(python -B ${PLUGIN_ROOT}/skills/merge/scripts/cleanup_proof.py)",
        "PowerShell(python -B ${PLUGIN_ROOT}/skills/merge/scripts/cleanup_proof.py)",
        "Bash(python -B ${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/worktree_sweep.py --repo:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/worktree_sweep.py --repo:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/worktree_sweep.py --repo:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/worktree_sweep.py --repo:*)",
        "Bash(python -B ${PLUGIN_ROOT}/skills/merge/scripts/worktree_sweep.py --repo:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/skills/merge/scripts/worktree_sweep.py --repo:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/skills/merge/scripts/worktree_sweep.py --repo:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/skills/merge/scripts/worktree_sweep.py --repo:*)",
        "Bash(python -B ${PLUGIN_ROOT}/workflows/pr_body.py --body-file:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/workflows/pr_body.py --body-file:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/workflows/pr_body.py --body-file:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/workflows/pr_body.py --body-file:*)"
      ],
      "codex_prefix_rules": [
        {
          "pattern": [
            [
              "python",
              "python.exe",
              "python3",
              "py"
            ],
            "-B",
            [
              "${PLUGIN_ROOT}/workflows/completion.py"
            ]
          ],
          "justification": "completion-check reads the canonical goal and freshly verifies every recorded delivery before a workflow may report completion; completed preparation or failed CI observation cannot establish the requested outcome",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/workflows/completion.py"
            ]
          ],
          "not_match": [
            [
              "python",
              "${PLUGIN_ROOT}/workflows/completion.py"
            ]
          ]
        },
        {
          "pattern": [
            [
              "python",
              "python.exe",
              "python3",
              "py"
            ],
            "-B",
            [
              "${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/cleanup_proof.py",
              "${PLUGIN_ROOT}/skills/merge/scripts/cleanup_proof.py",
              "${PLUGIN_ROOT}/codex-skills/merge/scripts/cleanup_proof.py"
            ]
          ],
          "justification": "engineering:merge Step 5: proves the PR merged at exactly this head before linked-worktree removal; a delivered report and verified idle session remain separate prerequisites for retained-session closure",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/cleanup_proof.py"
            ],
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/codex-skills/merge/scripts/cleanup_proof.py"
            ]
          ],
          "not_match": [
            [
              "python",
              "${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/cleanup_proof.py"
            ]
          ]
        },
        {
          "pattern": [
            [
              "python",
              "python.exe",
              "python3",
              "py"
            ],
            "-B",
            [
              "${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/worktree_sweep.py",
              "${PLUGIN_ROOT}/skills/merge/scripts/worktree_sweep.py",
              "${PLUGIN_ROOT}/codex-skills/merge/scripts/worktree_sweep.py"
            ],
            "--repo"
          ],
          "justification": "engineering:merge Step 5 removes proven-merged worktrees for one repository; it never forces, keeps worktrees in use, and archives leftovers first",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/skills/merge/scripts/worktree_sweep.py",
              "--repo",
              "C:/repo"
            ]
          ],
          "not_match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/skills/merge/scripts/other.py",
              "--repo",
              "C:/repo"
            ]
          ]
        },
        {
          "pattern": [
            [
              "python",
              "python.exe",
              "python3",
              "py"
            ],
            "-B",
            "${PLUGIN_ROOT}/workflows/pr_body.py",
            "--body-file"
          ],
          "justification": "Reads a proposed PR description and rejects missing or empty What and Why sections before any forge write; no repository or remote state changes",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/workflows/pr_body.py",
              "--body-file",
              "body.md"
            ]
          ],
          "not_match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/workflows/pr_body.py"
            ]
          ]
        }
      ],
      "auto_merge": {
        "claude_allow": [
          "Bash(python -B ${PLUGIN_ROOT}/workflows/auto_merge.py --root \"${PROJECT_ROOT}\")",
          "PowerShell(python -B ${PLUGIN_ROOT}/workflows/auto_merge.py --root \"${PROJECT_ROOT}\")"
        ],
        "codex_prefix_rules": [
          {
            "pattern": [
              [
                "python",
                "python.exe",
                "python3",
                "py"
              ],
              "-B",
              "${PLUGIN_ROOT}/workflows/auto_merge.py",
              "--root",
              "${PROJECT_ROOT}"
            ],
            "justification": "Rechecks required authorization, checkout identity, readiness, review, and security evidence before arming auto-merge for this declared checkout.",
            "match": [
              [
                "python",
                "-B",
                "${PLUGIN_ROOT}/workflows/auto_merge.py",
                "--root",
                "${PROJECT_ROOT}"
              ]
            ],
            "not_match": [
              [
                "python",
                "-B",
                "${PLUGIN_ROOT}/workflows/auto_merge.py",
                "--root"
              ]
            ]
          }
        ]
      }
    }
  }
}
