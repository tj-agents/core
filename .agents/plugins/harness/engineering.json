{
  "schema_version": 1,
  "plugin": "base-agents/engineering",
  "source_roots": [
    ".agents/engineering",
    ".agents/engineering/resources/problem-records.md",
    ".agents/hooks/callout_repair_gate.py",
    ".agents/hooks/continuation_stop.py",
    ".agents/hooks/docs_reachability.py",
    ".agents/hooks/hook_dispatch.py",
    ".agents/hooks/merge_cleanup_gate.py",
    ".agents/machine/scripts/repository_identity.py",
    ".agents/workflows",
    ".agents/workflows/repository_configuration.py"
  ],
  "requires": {
    "marketplaces": [
      {
        "id": "base-agents",
        "repository": "tj-agents/core"
      }
    ],
    "plugins": [
      "base-agents/base",
      "base-agents/engineering",
      "base-agents/machine"
    ],
    "hooks": [
      {
        "path": ".agents/engineering/policy/session-guidance/scripts/session-context.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/callout_repair_gate.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/compact_output_gate.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/continuation_stop.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/delivery_binding_gate.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/denial_prompt.py",
        "hosts": [
          "claude"
        ]
      },
      {
        "path": "hooks/forge_poll_gate.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/git_auth_scope_gate.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/harness_grant.py",
        "hosts": [
          "claude"
        ]
      },
      {
        "path": "hooks/hook_dispatch.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/merge_cleanup_gate.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/merge_review_gate.py",
        "hosts": [
          "claude"
        ]
      },
      {
        "path": "hooks/persistent_workflow_merge_gate.py",
        "hosts": [
          "claude"
        ]
      },
      {
        "path": "hooks/pre_tool_use_adapter.py",
        "hosts": [
          "codex"
        ]
      },
      {
        "path": "hooks/red_run_gate.py",
        "hosts": [
          "claude"
        ]
      },
      {
        "path": "hooks/workflow_route.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/worktree_cleanup_gate.py",
        "hosts": [
          "claude",
          "codex"
        ]
      },
      {
        "path": "hooks/worktree_placement_gate.py",
        "hosts": [
          "claude",
          "codex"
        ]
      }
    ],
    "permissions": {
      "claude_allow": [
        "Bash(python -B ${PLUGIN_ROOT}/hooks/merge_cleanup_gate.py --clear:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/hooks/merge_cleanup_gate.py --clear:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/hooks/merge_cleanup_gate.py --clear:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/hooks/merge_cleanup_gate.py --clear:*)",
        "Bash(python -B ${PLUGIN_ROOT}/workflows/completion.py)",
        "PowerShell(python -B ${PLUGIN_ROOT}/workflows/completion.py)",
        "Bash(python -B ${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/cleanup_proof.py)",
        "PowerShell(python -B ${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/cleanup_proof.py)",
        "Bash(python -B ${PLUGIN_ROOT}/skills/merge/scripts/cleanup_proof.py)",
        "PowerShell(python -B ${PLUGIN_ROOT}/skills/merge/scripts/cleanup_proof.py)",
        "Bash(python -B ${PLUGIN_ROOT}/.agents/engineering/utility/list-work/scripts/list-work.py:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/.agents/engineering/utility/list-work/scripts/list-work.py:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/.agents/engineering/utility/list-work/scripts/list-work.py:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/.agents/engineering/utility/list-work/scripts/list-work.py:*)",
        "Bash(python -B ${PLUGIN_ROOT}/skills/list-work/scripts/list-work.py:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/skills/list-work/scripts/list-work.py:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/skills/list-work/scripts/list-work.py:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/skills/list-work/scripts/list-work.py:*)"
      ],
      "codex_prefix_rules": [
        {
          "pattern": [
            [
              "python",
              "python.exe",
              "python3",
              "py"
            ],
            "-B",
            "${PLUGIN_ROOT}/hooks/merge_cleanup_gate.py",
            "--clear"
          ],
          "justification": "Records an evidenced retention disposition for the exact merged checkout after validating the real close refusal and separate fallback; pending cleanup remains incomplete",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/hooks/merge_cleanup_gate.py",
              "--clear",
              "${PROJECT_ROOT}",
              "--reason",
              "capability",
              "--evidence",
              "evidence.json"
            ]
          ],
          "not_match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/hooks/merge_cleanup_gate.py"
            ],
            [
              "python",
              "${PLUGIN_ROOT}/hooks/merge_cleanup_gate.py",
              "--clear"
            ]
          ]
        },
        {
          "pattern": [
            [
              "python",
              "python.exe",
              "python3",
              "py"
            ],
            "-B",
            [
              "${PLUGIN_ROOT}/workflows/completion.py"
            ]
          ],
          "justification": "completion-check reads the canonical goal and freshly verifies every recorded delivery before a workflow may report completion; completed preparation or failed CI observation cannot establish the requested outcome",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/workflows/completion.py"
            ]
          ],
          "not_match": [
            [
              "python",
              "${PLUGIN_ROOT}/workflows/completion.py"
            ]
          ]
        },
        {
          "pattern": [
            [
              "python",
              "python.exe",
              "python3",
              "py"
            ],
            "-B",
            [
              "${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/cleanup_proof.py",
              "${PLUGIN_ROOT}/skills/merge/scripts/cleanup_proof.py",
              "${PLUGIN_ROOT}/codex-skills/merge/scripts/cleanup_proof.py"
            ]
          ],
          "justification": "engineering:merge Step 5: proves the PR merged at exactly this head before linked-worktree removal; a delivered report and verified idle session remain separate prerequisites for retained-session closure",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/cleanup_proof.py"
            ],
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/codex-skills/merge/scripts/cleanup_proof.py"
            ]
          ],
          "not_match": [
            [
              "python",
              "${PLUGIN_ROOT}/.agents/engineering/workflow/merge/scripts/cleanup_proof.py"
            ]
          ]
        },
        {
          "pattern": [
            [
              "python",
              "python.exe",
              "python3",
              "py"
            ],
            "-B",
            [
              "${PLUGIN_ROOT}/.agents/engineering/utility/list-work/scripts/list-work.py",
              "${PLUGIN_ROOT}/skills/list-work/scripts/list-work.py",
              "${PLUGIN_ROOT}/codex-skills/list-work/scripts/list-work.py"
            ]
          ],
          "justification": "Reads the current plan corpus and recorded work-item status to report scoped unfinished work; it does not write repository or session state",
          "match": [
            [
              "python3",
              "-B",
              "${PLUGIN_ROOT}/.agents/engineering/utility/list-work/scripts/list-work.py",
              "postgres"
            ],
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/codex-skills/list-work/scripts/list-work.py"
            ]
          ],
          "not_match": [
            [
              "python",
              "${PLUGIN_ROOT}/.agents/engineering/utility/list-work/scripts/list-work.py"
            ],
            [
              "python3",
              "-B",
              "${PLUGIN_ROOT}/.agents/engineering/utility/list-work/scripts/other.py"
            ]
          ]
        }
      ],
      "auto_merge": {
        "claude_allow": [
          "Bash(python -B ${PLUGIN_ROOT}/workflows/auto_merge.py --root \"${PROJECT_ROOT}\")",
          "PowerShell(python -B ${PLUGIN_ROOT}/workflows/auto_merge.py --root \"${PROJECT_ROOT}\")"
        ],
        "codex_prefix_rules": [
          {
            "pattern": [
              ["python", "python.exe", "python3", "py"],
              "-B",
              "${PLUGIN_ROOT}/workflows/auto_merge.py",
              "--root",
              "${PROJECT_ROOT}"
            ],
            "justification": "rechecks the freshly validated repository settings preference, current authorization, exact checkout identity, readiness, review, and security evidence before it can arm auto-merge for this declared checkout",
            "match": [
              ["python", "-B", "${PLUGIN_ROOT}/workflows/auto_merge.py", "--root", "${PROJECT_ROOT}"]
            ],
            "not_match": [
              ["python", "-B", "${PLUGIN_ROOT}/workflows/auto_merge.py", "--root"]
            ]
          }
        ]
      }
    }
  }
}
