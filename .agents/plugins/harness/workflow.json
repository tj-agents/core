{
  "schema_version": 1,
  "plugin": "tj-agents/workflow",
  "source_roots": [
    ".agents/agent-store/runtime",
    ".agents/hooks/problem_records.py",
    ".agents/tiers/workflow.json",
    ".agents/workflow",
    ".agents/workflow/resources/problem-records.md"
  ],
  "requires": {
    "marketplaces": [
      {
        "id": "tj-agents",
        "repository": "tj-agents/marketplace"
      }
    ],
    "plugins": [
      "tj-agents/agent-store",
      "tj-agents/base",
      "tj-agents/machine",
      "tj-agents/workflow"
    ],
    "hooks": [],
    "permissions": {
      "claude_allow": [
        "Bash(python -B ${PLUGIN_ROOT}/.agents/workflow/utility/status/scripts/status.py:*)",
        "Bash(python -B ${PLUGIN_ROOT}/skills/status/scripts/status.py:*)",
        "Bash(python -B ${PLUGIN_ROOT}/codex-skills/status/scripts/status.py:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/.agents/workflow/utility/status/scripts/status.py:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/skills/status/scripts/status.py:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/codex-skills/status/scripts/status.py:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/.agents/workflow/utility/status/scripts/status.py:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/skills/status/scripts/status.py:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/codex-skills/status/scripts/status.py:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/.agents/workflow/utility/status/scripts/status.py:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/skills/status/scripts/status.py:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/codex-skills/status/scripts/status.py:*)",
        "Bash(python -B ${PLUGIN_ROOT}/.agents/workflow/workflow/orchestrate/scripts/orchestrate.py:*)",
        "Bash(python -B ${PLUGIN_ROOT}/skills/orchestrate/scripts/orchestrate.py:*)",
        "Bash(python -B ${PLUGIN_ROOT}/codex-skills/orchestrate/scripts/orchestrate.py:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/.agents/workflow/workflow/orchestrate/scripts/orchestrate.py:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/skills/orchestrate/scripts/orchestrate.py:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/codex-skills/orchestrate/scripts/orchestrate.py:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/.agents/workflow/workflow/orchestrate/scripts/orchestrate.py:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/skills/orchestrate/scripts/orchestrate.py:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/codex-skills/orchestrate/scripts/orchestrate.py:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/.agents/workflow/workflow/orchestrate/scripts/orchestrate.py:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/skills/orchestrate/scripts/orchestrate.py:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/codex-skills/orchestrate/scripts/orchestrate.py:*)"
      ],
      "codex_prefix_rules": [
        {
          "pattern": [
            [
              "python",
              "python3"
            ],
            "-B",
            [
              "${PLUGIN_ROOT}/.agents/workflow/utility/status/scripts/status.py",
              "${PLUGIN_ROOT}/skills/status/scripts/status.py",
              "${PLUGIN_ROOT}/codex-skills/status/scripts/status.py"
            ]
          ],
          "justification": "Read selected work-item state and supporting plans without creating or changing agent-store records.",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/codex-skills/status/scripts/status.py",
              "payments"
            ],
            [
              "python3",
              "-B",
              "${PLUGIN_ROOT}/.agents/workflow/utility/status/scripts/status.py",
              "payments",
              "20",
              "all"
            ]
          ],
          "not_match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/writer.py"
            ],
            [
              "python",
              "${PLUGIN_ROOT}/skills/status/scripts/status.py",
              "payments"
            ]
          ]
        },
        {
          "pattern": [
            [
              "python",
              "python3"
            ],
            "-B",
            [
              "${PLUGIN_ROOT}/.agents/workflow/workflow/orchestrate/scripts/orchestrate.py",
              "${PLUGIN_ROOT}/skills/orchestrate/scripts/orchestrate.py",
              "${PLUGIN_ROOT}/codex-skills/orchestrate/scripts/orchestrate.py"
            ]
          ],
          "justification": "Run the orchestration file: dispatch workers, record the user's decisions, merge approved PRs and close finished workers.",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/codex-skills/orchestrate/scripts/orchestrate.py",
              "tick",
              "--name",
              "core-435"
            ],
            [
              "python3",
              "-B",
              "${PLUGIN_ROOT}/.agents/workflow/workflow/orchestrate/scripts/orchestrate.py",
              "status"
            ]
          ],
          "not_match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/writer.py"
            ],
            [
              "python",
              "${PLUGIN_ROOT}/skills/orchestrate/scripts/orchestrate.py",
              "tick"
            ]
          ]
        }
      ]
    }
  }
}
