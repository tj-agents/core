    "claude": [
      "(?i)[`/]code-review(?![-\\w/])",
      "(?i)[`/]security-review(?![-\\w/])",
      "\\b`?Skill`?\\s+[Tt]ool\\b",
      "(?i)\\bAskUserQuestion\\b",
      "(?i)\\bToolSearch\\b",
      "\\bCLAUDE_PLUGIN_ROOT\\b"
