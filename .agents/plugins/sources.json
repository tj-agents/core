      {"id": "tj-agents/agent", "marketplace": "tj-agents", "repository": "tj-agents/agent"},
      {"id": "tj-agents/cli", "marketplace": "tj-agents", "repository": "tj-agents/cli"}
    ]
  },
  "extended_host_adapters": [
    "engineering:persistent-workflow",
    "engineering:review"
  ],
  "host_only_terms": {
    "claude": [
      "(?i)[`/]code-review(?![-\\w/])",
      "(?i)[`/]security-review(?![-\\w/])",
      "\\b`?Skill`?\\s+[Tt]ool\\b",
      "(?i)\\bAskUserQuestion\\b",
      "(?i)\\bToolSearch\\b",
      "\\bCLAUDE_PLUGIN_ROOT\\b"
    ],
    "codex": [
      "\\bcodex\\s+(?:review|exec)\\b",
      "\\bScheduled Task\\b"
    ]
  },
  "workflow": {
    "source": ".agents/workflows",
    "plugin": "engineering"
  }
