{
  "schema_version": 1,
  "selection_cases": [
    {
      "id": "author-primary",
      "request": "Design a phased plan and ledger for replacing the cache layer, but do not implement it.",
      "expected_skill": "plan",
      "description_terms": [
        "substantive work",
        "implementation-ready canonical plan"
      ]
    },
    {
      "id": "author-paraphrase",
      "request": "Break the billing migration into shippable stages with verification gates.",
      "expected_skill": "plan",
      "description_terms": [
        "substantive work",
        "implementation-ready canonical plan"
      ]
    },
    {
      "id": "author-design-reference",
      "request": "Research the authorization model and write AUTHORIZATION_MODEL.md so another agent can implement the decision; do not write production code.",
      "expected_skill": "plan",
      "description_terms": [
        "substantive work",
        "implementation-ready canonical plan"
      ]
    },
    {
      "id": "execute-primary",
      "request": "Read plans/runtime/RUNTIME_PROGRESS.md and implement its Next Steps continuously.",
      "expected_skill": "run",
      "description_terms": [
        "sustained or multiphase",
        "actual acceptance condition"
      ]
    },
    {
      "id": "execute-paraphrase",
      "request": "Resume the uniquely active import plan and keep going across its remaining phases.",
      "expected_skill": "run",
      "description_terms": [
        "sustained or multiphase",
        "actual acceptance condition"
      ]
    },
    {
      "id": "roadmap-choice",
      "request": "Choose and plan the next implementable payments item.",
      "expected_skill": "plan",
      "description_terms": [
        "choose what to plan next"
      ]
    },
    {
      "id": "resume-reconstruction",
      "request": "Reconstruct the interrupted legacy handoff.",
      "expected_skill": "resume",
      "description_terms": [
        "after interruption"
      ]
    },
    {
      "id": "feature-neighbor",
      "request": "Add CSV export as one obvious unplanned change.",
      "expected_skill": "feature",
      "description_terms": [
        "when no active plan owns the work",
        "do not use for defect repair"
      ]
    },
    {
      "id": "review-neighbor",
      "request": "Review the current plan branch without implementing it.",
      "expected_skill": "review",
      "description_terms": [
        "full code review",
        "review a branch"
      ]
    }
  ],
  "authoring_scenarios": [
    {
      "id": "planning-only-authoring",
      "implementation_authorized": false,
      "terminal": "complete"
    },
    {
      "id": "author-then-execute",
      "implementation_authorized": true,
      "terminal": "continue"
    }
  ],
  "scenarios": [
    {
      "id": "multi-phase-continuation",
      "entry": "run",
      "workflow": "run",
      "events": [
        "resolve",
        "implement-phase-one",
        "focused-validate",
        "checkpoint-phase-one",
        "continue",
        "implement-phase-two",
        "focused-validate",
        "checkpoint-phase-two",
        "complete"
      ],
      "checkpoints": {
        "checkpoint-phase-one": "Implement phase two.",
        "checkpoint-phase-two": "Complete: Both phases are verified."
      },
      "terminal": "complete"
    },
    {
      "id": "phase-checkpoint-without-stop",
      "entry": "run",
      "workflow": "run",
      "events": [
        "resolve",
        "implement-phase",
        "focused-validate",
        "checkpoint-phase",
        "continue",
        "select-next-phase"
      ],
      "checkpoints": {
        "checkpoint-phase": "Implement the next phase."
      },
      "terminal": "continue"
    },
    {
      "id": "validation-failure-recovery",
      "entry": "run",
      "workflow": "run",
      "events": [
        "resolve",
        "validation-failed",
        "parent-diagnosis",
        "repair",
        "revalidate",
        "checkpoint-repair",
        "continue"
      ],
      "checkpoints": {
        "checkpoint-repair": "Prepare the reviewed delivery candidate."
      },
      "terminal": "continue"
    },
    {
      "id": "fresh-context-transfer",
      "entry": "run",
      "workflow": "run",
      "events": [
        "resolve",
        "checkpoint-transfer",
        "transfer"
      ],
      "checkpoints": {
        "checkpoint-transfer": "Resume from the transferred context after reading this ledger."
      },
      "resume_condition": "A fresh parent resolves the same ledger and Git identity.",
      "terminal": "transfer"
    },
    {
      "id": "blocker-return-path",
      "entry": "run",
      "workflow": "run",
      "events": [
        "resolve",
        "block",
        "reciprocal-return"
      ],
      "checkpoints": {},
      "blocker": {
        "reason": "The dependency contract is unavailable.",
        "owner": "plans/dependency/DEPENDENCY_PROGRESS.md",
        "action": "Land the dependency contract.",
        "resume": "The dependency ledger records the published contract and return path."
      },
      "terminal": "block"
    },
    {
      "id": "restart-recovery",
      "entry": "run",
      "workflow": "run",
      "events": [
        "resolve",
        "checkpoint-restart",
        "restart",
        "re-resolve",
        "continue",
        "complete"
      ],
      "checkpoints": {
        "checkpoint-restart": "Resume the next phase after provider restart."
      },
      "terminal": "complete"
    },
    {
      "id": "review-finding-recovery",
      "entry": "run",
      "workflow": "run",
      "events": [
        "resolve",
        "checkpoint-review",
        "review-finding",
        "address-review",
        "checkpoint-review-repair",
        "incremental-review",
        "continue"
      ],
      "checkpoints": {
        "checkpoint-review": "Run the immutable candidate review.",
        "checkpoint-review-repair": "Run incremental review over the repair delta."
      },
      "terminal": "continue"
    },
    {
      "id": "trusted-continuation-resume",
      "entry": "run",
      "workflow": "run",
      "events": [
        "accept-continuation",
        "implement-phase",
        "focused-validate",
        "checkpoint-phase",
        "continue"
      ],
      "checkpoints": {
        "checkpoint-phase": "Implement the next phase."
      },
      "continuation": {
        "next_steps": "Implement phase one."
      },
      "terminal": "continue"
    },
    {
      "id": "contradicted-continuation-rereads",
      "entry": "run",
      "workflow": "run",
      "events": [
        "contradicted-continuation",
        "implement-phase",
        "focused-validate",
        "continue"
      ],
      "checkpoints": {},
      "continuation": {
        "next_steps": "Implement phase one."
      },
      "terminal": "continue"
    },
    {
      "id": "pr-slice-rollover",
      "entry": "run",
      "workflow": "run",
      "events": [
        "resolve",
        "checkpoint-slice-one",
        "merge-slice",
        "rollover-slice",
        "continue"
      ],
      "checkpoints": {
        "checkpoint-slice-one": "Deliver the reviewed first PR slice."
      },
      "rollover_next_steps": "Implement the second PR slice from fresh default.",
      "terminal": "continue"
    }
  ]
}
