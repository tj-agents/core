{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tj-agents/core/blob/main/.agents/schemas/tier.schema.json",
  "title": "Plugin tier declaration",
  "description": "Ships at the root of a plugin payload as tier.json and states whether that plugin is ubiquitous or gated on a stack. The plugin and marketplace identity is taken from the installed path, never declared here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tier",
    "applies"
  ],
  "properties": {
    "tier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "applies": {
      "enum": [
        "always",
        "stack-present"
      ]
    },
    "stack": {
      "type": "string",
      "minLength": 1,
      "description": "Human name of the stack, used in the session statement and the block message."
    },
    "detect": {
      "$ref": "#/$defs/predicate"
    },
    "fact_definitions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "\\S"
      },
      "additionalProperties": {
        "$ref": "#/$defs/predicate"
      }
    },
    "employer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_skill"
      ],
      "properties": {
        "context_skill": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"
        }
      },
      "description": "A gated employer declaration supplies a local shipped skills/<context_skill>/SKILL.md. Only a genuine detection match establishes the reserved employer fact."
    },
    "session_context": {
      "type": "string",
      "pattern": "^[^\\r\\n\\u0085\\u2028\\u2029]*\\S[^\\r\\n\\u0085\\u2028\\u2029]*(?![\\s\\S])",
      "description": "One non-empty line emitted only when this tier applies."
    }
  },
  "$defs": {
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "glob"
          ],
          "properties": {
            "glob": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "remote"
          ],
          "properties": {
            "remote": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "remote_host"
          ],
          "properties": {
            "remote_host": {
              "type": "string",
              "pattern": "^(?=.{1,253}\\.?(?![\\s\\S]))[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?(?![\\s\\S])",
              "description": "Exact case-insensitive origin hostname. Supports HTTP(S), SSH and Git URLs and user@host:path SCP origins. Local, file and malformed origins do not match."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fact"
          ],
          "properties": {
            "fact": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content"
          ],
          "properties": {
            "content": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "glob",
                "pattern"
              ],
              "properties": {
                "glob": {
                  "type": "string",
                  "minLength": 1
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context"
          ],
          "properties": {
            "context": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "equals": {
                  "type": "string",
                  "minLength": 1
                },
                "contains": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "oneOf": [
                {
                  "required": [
                    "equals"
                  ]
                },
                {
                  "required": [
                    "contains"
                  ]
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dependency"
          ],
          "properties": {
            "dependency": {
              "$ref": "#/$defs/dependency"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_dependency"
          ],
          "properties": {
            "project_dependency": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "transitive",
                "where"
              ],
              "properties": {
                "transitive": {
                  "type": "boolean"
                },
                "where": {
                  "$ref": "#/$defs/predicate"
                }
              }
            }
          }
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "nuget",
            "npm",
            "sdk",
            "framework"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "prefix"
          ]
        }
      ]
    },
    "nonEmployerPredicate": {
      "allOf": [
        {
          "$ref": "#/$defs/predicate"
        },
        {
          "not": {
            "required": [
              "fact"
            ],
            "properties": {
              "fact": {
                "const": "employer"
              }
            }
          }
        }
      ],
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/nonEmployerPredicate"
          }
        },
        "any": {
          "items": {
            "$ref": "#/$defs/nonEmployerPredicate"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "applies": {
            "const": "stack-present"
          }
        }
      },
      "then": {
        "required": [
          "detect"
        ]
      }
    },
    {
      "if": {
        "required": [
          "employer"
        ]
      },
      "then": {
        "properties": {
          "applies": {
            "const": "stack-present"
          },
          "detect": {
            "$ref": "#/$defs/nonEmployerPredicate"
          }
        },
        "required": [
          "detect"
        ]
      }
    }
  ]
}
