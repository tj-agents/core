{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tj-agents/core/blob/main/.agents/schemas/tier.schema.json",
  "title": "Plugin tier declaration",
  "description": "Ships at the root of a plugin payload as tier.json and states whether that plugin is ubiquitous or gated on a stack. The plugin and marketplace identity is taken from the installed path, never declared here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tier",
    "applies"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "tier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "applies": {
      "enum": [
        "always",
        "stack-present"
      ]
    },
    "stack": {
      "type": "string",
      "minLength": 1,
      "description": "Human name of the stack, used in the session statement and the block message."
    },
    "owner_repository": {
      "description": "owner/name of the repository that authors this tier, or several when its remotes differ. The gate never fires inside one, so a tier's own standards stay readable while they are being edited.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[^/ ]+/[^/ ]+$"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^/ ]+/[^/ ]+$"
          },
          "uniqueItems": true
        }
      ]
    },
    "detect": {},
    "employer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_skill"
      ],
      "properties": {
        "context_skill": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"
        }
      },
      "description": "A v3 gated employer declaration supplies a local shipped skills/<context_skill>/SKILL.md. Only a genuine detection match establishes the reserved employer fact."
    },
    "session_context": {
      "type": "string",
      "pattern": "^[^\\r\\n\\u0085\\u2028\\u2029]*\\S[^\\r\\n\\u0085\\u2028\\u2029]*(?![\\s\\S])",
      "description": "One non-empty line emitted only when this v3 tier applies."
    }
  },
  "$defs": {
    "legacyDetect": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present when any one matcher matches. Required for applies=stack-present and meaningless otherwise.",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Repository-relative paths that exist only when the stack does."
        },
        "globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Filename patterns matched at any depth."
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "glob",
              "pattern"
            ],
            "properties": {
              "glob": {
                "type": "string",
                "minLength": 1
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "A file whose name matches glob and whose text matches pattern."
        },
        "remote": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Regular expressions matched case-insensitively against the repository's origin identity as owner/name. Requires schema_version 2; a version-1 gate ignores the whole declaration."
        }
      }
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "glob"
          ],
          "properties": {
            "glob": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "remote"
          ],
          "properties": {
            "remote": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fact"
          ],
          "properties": {
            "fact": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content"
          ],
          "properties": {
            "content": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "glob",
                "pattern"
              ],
              "properties": {
                "glob": {
                  "type": "string",
                  "minLength": 1
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context"
          ],
          "properties": {
            "context": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "equals": {
                  "type": "string",
                  "minLength": 1
                },
                "contains": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "oneOf": [
                {
                  "required": [
                    "equals"
                  ]
                },
                {
                  "required": [
                    "contains"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "nonEmployerPredicate": {
      "allOf": [
        {
          "$ref": "#/$defs/predicate"
        },
        {
          "not": {
            "required": [
              "fact"
            ],
            "properties": {
              "fact": {
                "const": "employer"
              }
            }
          }
        }
      ],
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/nonEmployerPredicate"
          }
        },
        "any": {
          "items": {
            "$ref": "#/$defs/nonEmployerPredicate"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "detect": {
            "$ref": "#/$defs/predicate"
          }
        }
      },
      "else": {
        "properties": {
          "detect": {
            "$ref": "#/$defs/legacyDetect"
          },
          "employer": false,
          "session_context": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "applies": {
            "const": "stack-present"
          }
        }
      },
      "then": {
        "required": [
          "detect"
        ]
      }
    },
    {
      "if": {
        "required": [
          "employer"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": 3
          },
          "applies": {
            "const": "stack-present"
          },
          "detect": {
            "$ref": "#/$defs/nonEmployerPredicate"
          }
        },
        "required": [
          "detect"
        ]
      }
    }
  ]
}
