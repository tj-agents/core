{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "configuration": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "properties": {
        "core": {
          "type": "object",
          "properties": {
            "auto_merge": {"type": "boolean"},
            "permissions": {"enum": ["bypass", "standard"], "default": "bypass"},
            "auto_approve": {
              "type": "object",
              "properties": {
                "all": {"type": "boolean"},
                "design": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": {"type": "object"}
    }
  }
}
