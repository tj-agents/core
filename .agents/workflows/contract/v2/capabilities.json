{
  "contract_version": "v2",
  "delegable_capabilities": {
    "evidence-explorer": {
      "mode": "read",
      "default_semantic_stage": "mechanical",
      "allowed_semantic_stages": ["strategic", "implementation", "mechanical", "critical"],
      "fresh_context": true,
      "parallelism": "non-overlapping-readers",
      "may_decide": ["repository evidence and its location"],
      "must_not_decide": ["product scope", "architecture", "implementation choice"]
    },
    "log-analyst": {
      "mode": "read",
      "default_semantic_stage": "mechanical",
      "allowed_semantic_stages": ["implementation", "mechanical", "critical"],
      "fresh_context": true,
      "parallelism": "independent-readers",
      "may_decide": ["failure signatures", "chronology", "correlations", "evidence gaps"],
      "must_not_decide": ["root cause", "causal fix"]
    },
    "test-impact-analyst": {
      "mode": "read",
      "default_semantic_stage": "implementation",
      "allowed_semantic_stages": ["implementation", "review"],
      "fresh_context": true,
      "parallelism": "independent-readers",
      "may_decide": ["affected tests", "coverage gaps", "repository-supported validation commands"],
      "must_not_decide": ["risk acceptance", "validation sufficiency"]
    },
    "review-lens": {
      "mode": "read",
      "default_semantic_stage": "review",
      "allowed_semantic_stages": ["review"],
      "fresh_context": true,
      "parallelism": "independent-lenses",
      "may_decide": ["candidate findings", "supporting evidence", "confidence"],
      "must_not_decide": ["severity", "approval", "final review judgment"]
    },
    "mechanical-worker": {
      "mode": "write",
      "default_semantic_stage": "mechanical",
      "allowed_semantic_stages": ["mechanical"],
      "fresh_context": false,
      "parallelism": "serialized-writer",
      "may_decide": ["exact transformation inside the writer lease"],
      "must_not_decide": ["scope", "public contract", "architecture", "security", "migration", "follow-on work"]
    }
  },
  "parent_authority_stages": [
    "task-classification",
    "architecture",
    "diagnosis",
    "implementation-acceptance",
    "public-contract",
    "security",
    "migration",
    "review-synthesis",
    "severity",
    "final-judgment"
  ],
  "semantic_stage_routing": {
    "selection_priority": ["critical", "strategic", "review", "implementation", "mechanical"],
    "protected_stages": ["strategic", "review", "critical"],
    "stages": {
      "strategic": {
        "signals": ["ambiguous", "high-level", "architecture", "major-planning", "cross-cutting-diagnosis"]
      },
      "implementation": {
        "signals": ["implementation", "ci-repair", "debugging", "focused-testing", "test-coverage", "judgment-required"]
      },
      "mechanical": {
        "signals": ["deterministic-inventory", "repetitive-processing", "mechanical-verification"]
      },
      "review": {
        "signals": ["implementation-ready", "pre-merge", "independent-review"]
      },
      "critical": {
        "signals": ["security-sensitive", "migration-critical", "irreversible-decision", "high-risk"]
      }
    }
  },
  "result_statuses": ["complete", "incomplete", "blocked", "cancelled"],
  "transitions": {
    "continue": "Run the resolved safe reversible next stage in the same workstream.",
    "retry": "Repeat one bounded stage only after a correctable incomplete result or transient failure.",
    "fallback": "Cancel the dispatch and execute the same bounded contract in the parent.",
    "cancel": "Close the dispatch and ignore late or obsolete results.",
    "checkpoint": "Persist a material recovery transition in the owning artifact.",
    "transfer": "Checkpoint and move ownership to a deliberately fresh context.",
    "pause": "Stop for a named human or external action with an observable resume condition.",
    "block": "Stop on an owned dependency with an objective unblock condition and return path.",
    "complete": "Finish only when the workflow outcome and all required gates are terminal."
  }
}
